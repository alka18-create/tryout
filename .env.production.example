# ==============================================================================
# ENVIRONMENT VARIABLES PRODUKSI — TryoutKu
# Salin file ini menjadi .env.production di VPS:
#   cp .env.production.example .env.production
# ==============================================================================

# ─── 1. URL Domain Aplikasi ───────────────────────────────────────────────────
# Contoh: https://tryoutku.com atau https://cbt.sekolah.sch.id (Gunakan HTTPS)
APP_URL="https://cbt.domainanda.com"

# ─── 2. Database PostgreSQL Internal Docker ──────────────────────────────────
POSTGRES_USER="tryoutku_admin"
# Ganti dengan password database yang sangat kuat:
POSTGRES_PASSWORD="ganti_dengan_password_db_yang_sangat_kuat_dan_rahasia"
POSTGRES_DB="tryoutku_prod"

# Otomatis digunakan aplikasi di dalam docker:
# DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ─── 3. Auth.js / NextAuth (Wajib!) ──────────────────────────────────────────
# Hasilkan secret acak 32-byte di terminal dengan perintah:
#   openssl rand -base64 32
AUTH_SECRET="ganti_dengan_hasil_openssl_rand_base64_32"

# ─── 4. Google OAuth (Opsional - Isi jika menggunakan Login Google) ───────────
# Daftarkan redirect URI di Google Cloud Console:
#   https://cbt.domainanda.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 5. Email Provider (Opsional - Reset Password) ───────────────────────────
EMAIL_FROM="noreply@cbt.domainanda.com"
EMAIL_PROVIDER_API_KEY=""

# ─── 6. Akun Admin Awal (Digunakan saat seed produksi pertama kali) ───────────
INITIAL_ADMIN_EMAIL="admin@cbt.domainanda.com"
INITIAL_ADMIN_PASSWORD="ganti_dengan_password_admin_yang_sangat_kuat"
INITIAL_ADMIN_NAME="Administrator CBT"
